# Copy to pipeline/.env and fill in. Never commit .env.

# CloudKit user record name of the admin account. Must match `admin` in
# iWrestle/Models/Constants.swift or pushed events will not show under
# Settings -> My events.
ADMIN_RECORD_NAME=_992916714084805f440379cb506634d2

# Nominatim asks geocoding clients to identify themselves with a contact address.
NOMINATIM_EMAIL=you@example.com

# Fallback contact email for events whose source lists none. Phone is
# optional and is never invented.
DEFAULT_CONTACT_EMAIL=support@example.com

# Anthropic API key for `make enrich`, which reads each event's banner image.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: FloWrestling session cookie, only if the static listing proves thin.
# FLO_COOKIE=
